# Local-only database configuration. Keep the real value in an untracked .env file.
# SQLAlchemy accepts a standard Supabase PostgreSQL URL and uses psycopg 3.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Source-video validation defaults. MP4 only; override only with a documented product decision.
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=1800
# Separate worker poll interval; default is 1 second.
JOB_WORKER_POLL_INTERVAL_SECONDS=1
# Gemini translation. Keep the real API key only in the ignored local .env.
GEMINI_API_KEY=replace-with-local-gemini-api-key
# Discover IDs accessible to this API key with:
#   cd backend && .venv/Scripts/python.exe scripts/gemini_diagnostics.py list
# Set GEMINI_MODEL to one listed ID; the application will not switch models automatically.
GEMINI_MODEL=replace-with-accessible-generateContent-model-id
TRANSLATION_BATCH_SIZE=40
# App-level conservative Gemini request budgets. Lower these when GEMINI_MODEL has
# smaller documented limits. Request token estimates use UTF-8 bytes locally; no
# provider token-counting request is made. Full-transcript mode is capped separately.
TRANSLATION_INPUT_TOKEN_BUDGET=262144
TRANSLATION_OUTPUT_TOKEN_BUDGET=16384
TRANSLATION_BULK_MAX_SEGMENTS=500
TRANSLATION_BULK_MAX_SOURCE_CHARACTERS=120000
# Vietnamese Edge-TTS voice and maximum bounded Segment synthesis concurrency.
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_CONCURRENCY=5
# Duration optimization is bounded to these Edge-TTS rate/attempt limits.
TTS_OPTIMIZATION_MAX_RATE_PERCENT=35
TTS_OPTIMIZATION_MAX_ATTEMPTS=4
# Legacy default for render API clients that omit per-render audio settings (0.0 to 1.0).
RENDER_ORIGINAL_AUDIO_GAIN=0.10
